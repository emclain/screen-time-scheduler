
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# macOS
.DS_Store

# Xcode per-user state (schemes under xcshareddata/ ARE committed)
xcuserdata/
*.xcuserstate

# Provisioning profiles — signing assets, fetched per-machine from the
# developer portal. Never commit; see TEST_SETUP.md for how to obtain them.
*.mobileprovision
*.provisionprofile

# Local Claude Code settings (per-machine permissions)
.claude/settings.local.json
